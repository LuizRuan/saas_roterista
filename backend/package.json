{
  "name": "gancho-api",
  "version": "0.1.0",
  "private": true,
  "description": "API da plataforma Gancho — geração de roteiros virais com IA",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:memoria": "tsx scripts/dev-sem-atlas.ts",
