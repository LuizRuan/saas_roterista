# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.

NODE_ENV=development
PORT=4000

# String de conexão do MongoDB Atlas (free tier):
# https://www.mongodb.com/cloud/atlas → Create Cluster → Connect → Drivers
MONGODB_URI=

# URL do frontend (CORS). Em produção, o domínio da Vercel. Obrigatória em produção.
CLIENT_URL=http://localhost:3000
# Origens extras permitidas no CORS (ex.: previews da Vercel), por vírgula. Opcional.
CORS_ORIGINS=

# Segredos dos tokens JWT — obrigatórios em produção e DIFERENTES entre si.
# Gere valores fortes com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Chaves de IA — gratuitas
# Groq (principal): https://console.groq.com → API Keys
GROQ_API_KEY=
# Gemini (fallback): https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# E-mail (recuperação de senha) — resend.com (100 emails/dia grátis)
RESEND_API_KEY=

# CAPTCHA anti-bot (cadastro e recuperação de senha) — Cloudflare Turnstile (grátis).
# https://dash.cloudflare.com → Turnstile → Add site. Sem essa chave, a
# verificação é pulada em dev (log de aviso). OBRIGATÓRIA em produção.
TURNSTILE_SECRET_KEY=

# Opcional — se definido, recebe alerta por e-mail quando algo crítico
# quebra em produção (IA fora do ar, banco caiu, exceção não tratada).
ALERTA_EMAIL=

# ─── Pagamento Pix (plano pro — Mercado Pago) ────────────────────────────────
# Sem o token, as rotas de pagamento respondem 503 (feature desligada).
# https://www.mercadopago.com.br/developers → Credenciais → Access Token (produção).
MERCADOPAGO_ACCESS_TOKEN=
# Segredo para validar a assinatura dos webhooks (gerado ao configurar a URL
# POST /pagamentos/webhook no painel do Mercado Pago).
MERCADOPAGO_WEBHOOK_SECRET=
# Preço do plano pro em centavos (1990 = R$ 19,90). Troque sem mexer no código.
PLANO_PRO_PRECO_CENTAVOS=1990
