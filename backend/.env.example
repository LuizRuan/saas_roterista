# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.

NODE_ENV=development
PORT=4000

# String de conexão do MongoDB Atlas (free tier):
# https://www.mongodb.com/cloud/atlas → Create Cluster → Connect → Drivers
MONGODB_URI=

# URL do frontend (CORS). Em produção, o domínio da Vercel.
CLIENT_URL=http://localhost:3000

# Segredos dos tokens JWT — obrigatórios em produção e DIFERENTES entre si.
# Gere valores fortes com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Chaves de IA — gratuitas
# Groq (principal): https://console.groq.com → API Keys
GROQ_API_KEY=
# Gemini (fallback): https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# E-mail (recuperação de senha) — resend.com (100 emails/dia grátis)
RESEND_API_KEY=

# CAPTCHA anti-bot (cadastro e recuperação de senha) — Cloudflare Turnstile (grátis).
# https://dash.cloudflare.com → Turnstile → Add site. Sem essa chave, a
# verificação é pulada em dev (log de aviso).
TURNSTILE_SECRET_KEY=

# Opcional — se definido, recebe alerta por e-mail quando algo crítico
# quebra em produção (IA fora do ar, banco caiu, exceção não tratada).
ALERTA_EMAIL=

# ─── Pagamento PIX ───────────────────────────────────────────────────────────
# Chave HMAC para assinar códigos PIX (anti-fraude).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBRIGATÓRIA em produção.
PIX_HMAC_SECRET=

# Chave PIX do recebedor (e-mail, CPF, telefone ou chave aleatória).
PIX_CHAVE=

# Valor do plano Pro em centavos (2990 = R$ 29,90).
PIX_VALOR_PRO_CENTAVOS=2990
