# Copie este arquivo para .env.local e ajuste se necessário.

# URL da API Express (backend). Em produção, a URL do serviço no Render.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Site key do Cloudflare Turnstile (CAPTCHA em cadastro/recuperar-senha).
# https://dash.cloudflare.com → Turnstile → Add site.
# Sem essa variável, usa a chave de teste pública da Cloudflare (sempre passa
# em localhost) — funciona sem conta, mas não protege nada em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
